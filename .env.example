# ---- Demo mode ----
# Set to "true" to force synthetic/local fallbacks even if real keys are present.
DEMO_MODE=true

# ---- Anthropic (Claude Sonnet) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ---- HuggingFace Inference API (embeddings) ----
HUGGINGFACEHUB_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Azure Cosmos DB ----
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=genai_rag_demo
COSMOS_CONTAINER=documents

# ---- FAISS ----
FAISS_INDEX_PATH=./backend/data/faiss_index

# ---- App ----
APP_TITLE=Generative AI RAG SaaS — Architect Demo
